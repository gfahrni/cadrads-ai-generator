    given-names: "Guillaume"
version: "0.1.0"
date-released: "2026-11-10"
license: MIT
repository-code: "https://github.com/gfahrni/cadrads-ai-generator"
keywords:
  - CAD-RADS
  - coronary CT angiography
  - synthetic data
  - large language models
  - radiology reporting
  - reproducibility
